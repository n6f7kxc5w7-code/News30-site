{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/generate-video.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/ffmpeg-static/**,api/LiberationSans-Bold.ttf}"
    },
    "api/cron/process.js": {
      "maxDuration": 60
    },
    "api/cron/ingest.js": {
      "maxDuration": 30
    },
    "api/seo.js": {
      "maxDuration": 30
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/",
      "destination": "/api/seo?page=home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?page=sitemap"
    },
    {
      "source": "/story/:slug",
      "destination": "/api/seo?page=story&slug=:slug"
    },
    {
      "source": "/:cat(geopolitics|finance|sports)",
      "destination": "/api/seo?page=category&cat=:cat"
    }
  ],
  "headers": [
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
